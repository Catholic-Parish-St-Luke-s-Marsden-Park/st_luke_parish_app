# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Port the server listens on (hosts like Render set this automatically).
PORT=8080

# Shared secret required in the `x-api-key` header for /send and /broadcast.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# ID of the Firestore database (a named database, not "(default)").
FIRESTORE_DATABASE_ID=

# Local dev: path to the Firebase service-account JSON key.
# On a host with no key file (e.g. Render), leave this unset and set
# FIREBASE_SERVICE_ACCOUNT to the whole JSON key as a string instead.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json