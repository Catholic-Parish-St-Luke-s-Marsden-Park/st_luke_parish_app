# App-side config bundled into the app. Contains NO secrets: anything here can be
# extracted from the installed app.

# Parish API origin (parish_app_service). Origin only, no path: the app appends
# the route itself (e.g. POST /v1/devices for push notification registration,
# /v1/ministries for public read-only data). Use https:// for release builds.
# Android emulator -> host PC:  http://10.0.2.2:8080
# Production:                   https://parish-app-service.fly.dev
API_BASE_URL=https://parish-app-service.fly.dev
