# App-side config bundled into the app. Contains NO secrets: anything here can be
# extracted from the installed app. Server secrets live in server/.env only.

# Token registration endpoint. Use https:// for release builds.
# Android emulator -> host PC:  http://10.0.2.2:8080/tokens
# Production:                   [Production URL here]
BASE_URL=http://10.0.2.2:8080/tokens

# Parish API origin (parish_app_service), for the public read-only /v1/*
# endpoints such as /v1/ministries. Origin only, no path. Use https:// for
# release builds. If unset, the origin of BASE_URL is used instead.
API_BASE_URL=https://parish-app-service.fly.dev
